<%= form_with model: post, class: "post-form-card" do |f| %>
  <!-- エラーメッセージ表示 -->
  <% if post.errors.any? %>
    <div class="error-explanation">
      <p class="error-title"><%= post.errors.count %>件のエラーが発生しました</p>
      <ul>
        <% post.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="posts-new">
    <!-- 商品画像 -->
    <div class="field">
      <%= f.label :image, "商品画像" %>
      <div class="file-input-wrapper">
        <%= f.file_field :image, accept: "image/*", class: "form-control-file" %>
      </div>
    </div>

    <!-- 商品名 -->
    <div class="field">
      <%= f.label :product_name, "商品名" %>
      <%= f.text_field :product_name, placeholder: "例: 苺のショートケーキ", class: "form-control" %>
    </div>

    <!-- 店名 -->
    <div class="field">
      <%= f.label :shop_name, "店名" %>
      <%= f.text_field :shop_name, placeholder: "例: パティスリー〇〇", class: "form-control" %>
    </div>

    <!-- 価格 -->
    <div class="field">
      <%= f.label :price, "価格（円）" %>
      <%= f.number_field :price, placeholder: "例: 500", class: "form-control" %>
    </div>

    <!-- ジャンル -->
    <div class="field">
      <%= f.label :genre, "ジャンル" %>
      <%= f.select :genre, ["洋菓子", "和菓子", "和洋菓子", "その他"], { include_blank: "選択してください" }, { class: "form-control-select" } %>
    </div>

    <!-- 評価（星タップ入力） -->
    <div class="field">
      <%= f.label :rating, "評価（最高☆5）" %>
      <%= f.hidden_field :rating, id: "rating-input", value: post.rating || 0 %>

      <div class="star-rating" id="star-rating">
        <span class="star" data-value="1">★</span>
        <span class="star" data-value="2">★</span>
        <span class="star" data-value="3">★</span>
        <span class="star" data-value="4">★</span>
        <span class="star" data-value="5">★</span>
      </div>
    </div>

    <!-- エリア・住所 -->
    <div class="field">
      <%= f.label :area, "エリア・地域" %>
      <%= f.text_field :area, placeholder: "例: 東京都渋谷区...", class: "form-control" %>
    </div>

    <!-- 保存方法 -->
    <div class="field">
      <%= f.label :starage_temperature, "保存温度" %>
       <%#= f.select :starage_temperature, ["常温", "冷暗所", "冷蔵", "冷凍"], { include_blank: "選択してください" }, { class: "form-control-select" } %>
     <%= f.select :starage_temperature,
                              options_for_select(
                                Post.starage_temperatures.keys.map { |starage_temperature|
                                  [
                                    I18n.t("enums.post.starage_temperature.#{starage_temperature}"),
                                    starage_temperature
                                  ]
                                },
                                post.starage_temperature
                              ),
                              { include_blank: "選択してください" },
                              class: "form-control-select" %>
      </div>

    <!-- 持ち歩き時間 -->
    <div class="field">
      <%= f.label :carrying_time, "持ち歩き可能時間" %>
      <%= f.select :carrying_time, [["1時間以内", "1"], ["2時間以内", "2"], ["3時間以内", "3"], ["常温OK（制限なし）", "free"]], { include_blank: "選択してください" }, { class: "form-control-select" } %>
    </div>

    <!-- 日持ち・賞味期限 -->
    <div class="field">
      <%= f.label :shelf_life, "日持ち（目安）" %>
      <%= f.select :shelf_life, [["1日", 1], ["3日以内", 3], ["1週間以上", 7], ["2週間以上", 14], ["1ヶ月以上", 30]], { include_blank: "選択してください" }, { class: "form-control-select" } %>
    </div>

    <!-- 説明・詳細 -->
    <div class="field">
      <%= f.label :description, "説明・詳細" %>
      <%= f.text_area :description, placeholder: "味の感想やおすすめポイントなどを入力してください", class: "form-control-textarea" %>
    </div>

    <!-- タグ -->
    <div class="form-group">
      <!-- タグ（チップ&×ボタン削除UI） -->
      <div class="field tag-field-wrapper">
        <%= f.label :tag_names, "タグ" %>
        
        <!-- チップが並ぶコンテナ -->
        <div id="tag-chips-container" class="tag-chips-container">
          <!-- JSでここに [ #タグ名 × ] が動的に追加されます -->
          <input type="text" id="tag-input" placeholder="タグを入力してEnterまたはカンマ" class="tag-inner-input" autocomplete="off">
        </div>

        <!-- 候補リストを表示するドロップダウン -->
        <div id="tag-suggestions" class="tag-suggestions-box" style="display: none;"></div>

        <!-- Railsに送信するための hidden input -->
        <%= f.hidden_field :tag_names, id: "real-tag-input", value: @post.tag_names %>
        <small class="form-text text-muted">※ Enterキーまたはカンマ（,）でタグを確定できます。</small>
      </div>
    </div>

    <!-- 送信ボタン -->
    <div class="actions">
      <%= f.submit post.persisted? ? "更新する" : "投稿する", class: "btn-submit" %>
    </div>
  </div>
  <script>
  //  document.addEventListener("turbo:load", function() {
  function rating(){
      console.log("turbo:load");
      const stars = document.querySelectorAll("#star-rating .star");
      const ratingInput = document.getElementById("rating-input");

      if (!ratingInput) return;

      function updateStars(value) {
        stars.forEach(star => {
          const starValue = parseInt(star.getAttribute("data-value"));
          if (starValue <= value) {
            star.classList.add("active");
          } else {
            star.classList.remove("active");
          }
        });
      }

      const currentRating = parseInt(ratingInput.value);
      if (currentRating > 0) {
        updateStars(currentRating);
      }

      stars.forEach(star => {
        star.addEventListener("click", function() {
          const selectedValue = this.getAttribute("data-value");
          ratingInput.value = selectedValue;
          updateStars(selectedValue);
        });
      });
  // });
    }
    rating();

    <!-- タグ入力のJS -->
    function initTagSystem() {
      const container = document.getElementById("tag-chips-container");
      const input = document.getElementById("tag-input");
      const hiddenInput = document.getElementById("real-tag-input");
      const suggestionsBox = document.getElementById("tag-suggestions");

      if (!container || !input || !hiddenInput) return;

      // 初期値（@post.tag_names）からチップを復元
      let tags = hiddenInput.value ? hiddenInput.value.split(",").map(t => t.trim()).filter(Boolean) : [];

      function updateHiddenInput() {
        hiddenInput.value = tags.join(",");
      }

      function renderTags() {
        // 既存のチップを消去（inputは残す）
        container.querySelectorAll(".tag-chip-item").forEach(chip => chip.remove());

        tags.forEach((tagText, index) => {
          const chip = document.createElement("span");
          chip.className = "tag-chip-item";
          chip.innerHTML = `#${tagText} <button type="button" class="tag-remove-btn" data-index="${index}">&times;</button>`;
          container.insertBefore(chip, input);
        });

        updateHiddenInput();
      }

      function addTag(text) {
        const cleanText = text.replace(/[#\s,]/g, "").trim();
        if (cleanText && !tags.includes(cleanText)) {
          tags.push(cleanText);
          renderTags();
        }
        input.value = "";
        suggestionsBox.style.display = "none";
      }

      // 1. 文字入力・Enter・カンマ時のタグ追加
      input.addEventListener("keydown", function(e) {
        if (e.key === "Enter" || e.key === ",") {
          e.preventDefault();
          addTag(input.value);
        } else if (e.key === "Backspace" && input.value === "" && tags.length > 0) {
          // 入力欄が空でBackspaceを押したら最後のタグを削除
          tags.pop();
          renderTags();
        }
      });

      // 2. ×ボタンでタグ削除（イベント委任）
      container.addEventListener("click", function(e) {
        if (e.target.classList.contains("tag-remove-btn")) {
          const index = parseInt(e.target.getAttribute("data-index"));
          tags.splice(index, 1);
          renderTags();
        } else {
          input.focus();
        }
      });

      // 3. 候補（サジェストAPI）のリアルタイム取得
      input.addEventListener("input", function() {
        const query = input.value.trim();
        if (query.length < 1) {
          suggestionsBox.style.display = "none";
          return;
        }

        fetch(`/tags/search?q=${encodeURIComponent(query)}`)
          .then(res => res.json())
          .then(data => {
            if (data.length === 0) {
              suggestionsBox.style.display = "none";
              return;
            }

            suggestionsBox.innerHTML = "";
            data.forEach(tagName => {
              if (!tags.includes(tagName)) {
                const item = document.createElement("div");
                item.className = "suggestion-item";
                item.textContent = `#${tagName}`;
                item.addEventListener("click", () => addTag(tagName));
                suggestionsBox.appendChild(item);
              }
            });
            suggestionsBox.style.display = "block";
          });
      });

      // 初期表示実行
      renderTags();
    }

    // 評価（星）とタグ初期化を実行
    rating();
    initTagSystem();

  </script>
<% end %>
