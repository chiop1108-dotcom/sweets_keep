<div class="top-container">
  <div class="admin-header">
    <h2 class="page-title">【管理者用】ユーザー一覧・管理</h2>
    
    <!-- フィルターボタン -->
    <div class="admin-filter-group">
      <%= link_to "すべて", admin_users_path, class: "btn-detail-outline #{'active' if params[:role].blank?}" %>
      <%= link_to "一般ユーザー", admin_users_path(role: "general"), class: "btn-detail-outline #{'active' if params[:role] == 'general'}" %>
      <%= link_to "管理者", admin_users_path(role: "admin"), class: "btn-detail-outline #{'active' if params[:role] == 'admin'}" %>
    </div>
  </div>

  <div class="admin-table-wrapper">
    <table class="admin-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>ユーザー名</th>
          <th>メールアドレス</th>
          <th>現在の権限</th>
          <th>登録日</th>
          <th>投稿数</th>
          <th>操作</th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td data-label="ID"><%= user.id %></td>
            <td data-label="ユーザー名"><strong><%= user.user_name %></strong></td>
            <td data-label="メールアドレス"><%= user.email_address %></td>
            <td data-label="現在の権限">
              <% if user.role_admin? %>
                <span class="role-badge badge-admin">管理者</span>
              <% else %>
                <span class="role-badge badge-general">一般</span>
              <% end %>
            </td>
            <td data-label="登録日"><%= user.created_at.strftime('%Y/%m/%d %H:%M') %></td>
            <td data-label="投稿数"><%= user.posts.size %> 件</td>
            <td data-label="操作">
              <div class="admin-action-btns">
                <% if user == Current.user %>
                  <span class="text-muted">（自分自身）</span>
                <% else %>
                  <!-- 権限変更ボタン -->
                  <%= link_to toggle_role_admin_user_path(user), 
                              data: { turbo_method: :patch, turbo_confirm: "#{user.user_name} さんの権限を変更しますか？" }, 
                              class: "btn-detail-outline" do %>
                    <%= user.role_admin? ? "一般へ変更" : "管理者へ昇格" %>
                  <% end %>

                  <!-- 強制退会ボタン -->
                  <%= link_to "強制退会", admin_user_path(user), 
                              data: { turbo_method: :delete, turbo_confirm: "本当に #{user.user_name} さんを強制退会させますか？（投稿もすべて削除されます）" }, 
                              class: "btn-danger-custom" %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="admin-pagination">
    <%= paginate @users %>
  </div>
</div>