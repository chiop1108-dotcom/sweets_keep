<div class="container my-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>【管理者用】ユーザー一覧・管理</h1>
    
    <!-- フィルターボタン -->
    <div class="btn-group">
      <%= link_to "すべて", admin_users_path, class: "btn btn-outline-secondary #{'active' if params[:role].blank?}" %>
      <%= link_to "一般ユーザー", admin_users_path(role: "general"), class: "btn btn-outline-secondary #{'active' if params[:role] == 'general'}" %>
      <%= link_to "管理者", admin_users_path(role: "admin"), class: "btn btn-outline-secondary #{'active' if params[:role] == 'admin'}" %>
    </div>
  </div>

  <table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
      <tr>
        <th>ID</th>
        <th>ユーザー名</th>
        <th>メールアドレス</th>
        <th>現在の権限</th>
        <th>投稿数</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td><%= user.id %></td>
          <td><strong><%= user.user_name %></strong></td>
          <td><%= user.email_address %></td>
          <td>
             <!-- ユーザーの権限をわかりやすく色分け表示 -->
            <% if user.role_admin? %>
              <span class="badge bg-danger">管理者</span>
            <% else %>
              <span class="badge bg-secondary">一般</span>
            <% end %>
          </td>
           <!-- そのユーザーが投稿した件数を表示 -->
          <td><%= user.posts.count %> 件</td>
          <td>
            <div class="d-flex gap-2">
              <!-- 権限変更ボタン -->
              <% unless user == Current.user %>
                <!-- 管理者なら「一般へ変更」、一般ユーザーなら「管理者へ昇格」とボタンの文字を自動で切り替え -->
                <%= link_to toggle_role_admin_user_path(user), 
                            data: { turbo_method: :patch, turbo_confirm: "#{user.user_name} さんの権限を変更しますか？" }, 
                            class: "btn btn-sm btn-outline-primary" do %>
                  <%= user.role_admin? ? "一般へ変更" : "管理者へ昇格" %>
                <% end %>

                <!-- 強制退会ボタン -->
                <%= link_to "強制退会", admin_user_path(user), 
                            data: { turbo_method: :delete, turbo_confirm: "本当に #{user.user_name} さんを強制退会させますか？（投稿もすべて削除されます）" }, 
                            class: "btn btn-sm btn-danger" %>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>