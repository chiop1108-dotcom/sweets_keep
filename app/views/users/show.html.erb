<div class="user-show-container">
  <h2><%= @user == Current.user ? "マイページ" : "User Profile" %></h2>

  <!-- ユーザープロフィールカード -->
  <div class="profile-card">
    <div class="profile-avatar">
      <% if @user.profile_image.attached? %>
        <%= image_tag @user.profile_image.variant(resize_to_limit: [100, 100]), class: "avatar-img" %>
      <% else %>
        <%= image_tag 'logo.png', class: "avatar-img" %>
      <% end %>
    </div>

    <div class="profile-info">
      <h3 class="user-name"><%= @user.name %></h3>

      <% if authenticated? && @user == Current.user %>
        <p class="edit-link">
          <%= link_to "プロフィールを編集する", edit_user_path(@user), class: "btn-edit-profile" %>
        </p>
      <% end %>
    </div>
  </div>

  <h3 class="section-title">Posts</h3>

  <!-- ユーザーの投稿一覧（トップページ同様のグリッド配置） -->
  <div class="posts-grid">
    <% @posts.each do |post| %>
      <div class="post-card">
        <!-- 商品画像 -->
        <div class="post-image-wrapper">
          <%= link_to post_path(post) do %>
            <% if post.image.attached? %>
              <%= image_tag post.image, class: "post-thumb" %>
            <% else %>
              <div class="no-image">No Image</div>
            <% end %>
          <% end %>
        </div>

        <!-- カード本文 -->
        <div class="post-card-body">
          <h4 class="product-name"><%= link_to post.product_name, post_path(post) %></h4>

          <!-- 評価・価格 -->
          <div class="price-rating">
            <span class="rating">★ <%= post.rating || 0 %></span>
            <span class="price">¥<%= number_with_delimiter(post.price) %></span>
          </div>

          <!-- 持ち歩き時間・エリア -->
          <div class="post-meta">
            <p>
              ⏱️ 
              <% if post.carrying_time == "free" %>
                常温OK
              <% elsif post.carrying_time.present? %>
                <%= post.carrying_time %>時間
              <% else %>
                未設定
              <% end %>
            </p>
            <p>📍 <%= post.area.presence || "未設定" %></p>
          </div>

          <!-- いいね -->
          <div class="favorite-box">
            <% if post.favorited_by?(Current.user) %>
              <%= link_to post_favorite_path(post), data: { turbo_method: :delete }, class: "favorite-link active" do %>
                ♥ <%= post.favorites.count %> いいね
              <% end %>
            <% else %>
              <%= link_to post_favorite_path(post), data: { turbo_method: :post }, class: "favorite-link" do %>
                ♡ <%= post.favorites.count %> いいね
              <% end %>
            <% end %>
          </div>

          <!-- コメント件数 -->
          <p><%= link_to "#{post.comments.count} コメント", post_path(post) %></p>

          <!-- 投稿者 -->
          <!-- link_toと,user_path(post.user)を書き足すことで投稿者から他人のユーザーページへ遷移できるようにした -->
          <p class="post-user">投稿者: <%= link_to post.user.user_name, user_path(post.user) %></p>


          <!-- 詳細ボタン -->
          <%= link_to "詳細を見る", post_path(post), class: "btn-detail" %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="user-show-footer">
    <%= link_to "← トップページへ戻る", posts_path %>
  </div>

  <h2>Likes</h2>

  <!-- 投稿が存在するかの確認 -->
  <% if @favorite_posts.any? %>
    <div class="posts-grid">
      <% @favorite_posts.each do |post| %>
        <div class="post-card">
          <!-- 商品画像 -->
          <div class="post-image-wrapper">
            <%= link_to post_path(post) do %>
              <% if post.image.attached? %>
                <%= image_tag post.image, class: "post-thumb" %>
              <% else %>
                <div class="no-image">No Image</div>
              <% end %>
            <% end %>
          </div>

          <!-- カード本文 -->
          <div class="post-card-body">
            <h4 class="product-name"><%= link_to post.product_name, post_path(post) %></h4>

            <!-- 評価・価格 -->
            <div class="price-rating">
              <span class="rating">★ <%= post.rating || 0 %></span>
              <span class="price">¥<%= number_with_delimiter(post.price) %></span>
            </div>

            <!-- 持ち歩き時間・エリア -->
            <div class="post-meta">
              <p>
                ⏱️ 
                <% if post.carrying_time == "free" %>
                  常温OK
                <% elsif post.carrying_time.present? %>
                  <%= post.carrying_time %>時間
                <% else %>
                  未設定
                <% end %>
              </p>
              <p>📍 <%= post.area.presence || "未設定" %></p>
            </div>

            <!-- いいね -->
            <div class="favorite-box">
              <% if post.favorited_by?(Current.user) %>
                <%= link_to post_favorite_path(post), data: { turbo_method: :delete }, class: "favorite-link active" do %>
                  ♥ <%= post.favorites.count %> いいね
                <% end %>
              <% else %>
                <%= link_to post_favorite_path(post), data: { turbo_method: :post }, class: "favorite-link" do %>
                  ♡ <%= post.favorites.count %> いいね
                <% end %>
              <% end %>
            </div>

            <!-- コメント件数 -->
            <p><%= link_to "#{post.comments.count} コメント", post_path(post) %></p>

            <!-- 投稿者 -->
            <!-- link_toと,user_path(post.user)を書き足すことで投稿者から他人のユーザーページへ遷移できるようにした -->
            <p class="post-user">投稿者: <%= link_to post.user.user_name, user_path(post.user) %></p>

            <!-- 詳細ボタン -->
            <%= link_to "詳細を見る", post_path(post), class: "btn-detail" %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p>まだ「いいね」した投稿はありません。</p>
  <% end %>

</div>