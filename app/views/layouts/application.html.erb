<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Sweets Keep" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header>
      <nav class="header-nav">
        <ul class="header-menu-left">
          <% if authenticated? %>
            <!-- ログイン後 -->
            <li><%= link_to "Post", new_post_path, class: "header-menu-left-btn" %></li>
            <li><%= link_to "My page", user_path(Current.user), class: "header-menu-left-btn" %></li>
            <li><%= link_to "Log out", session_path, data: { turbo_method: :delete }, class: "header-menu-left-btn" %></li>

            <!-- 管理者側機能 -->
            <% if Current.user&.role_admin? %>
              <li><%= link_to "Admin", admin_root_path, class: "header-menu-left-btn" %></li>
            <% end %>

          <% else %>
            <!-- ログイン前 -->
            <li><%= link_to "About", about_path, class: "header-menu-left-btn" %></li>
            <li><%= link_to "Sign up", new_user_path, class: "header-menu-left-btn" %></li>
            <li><%= link_to "Log in", new_session_path, class: "header-menu-left-btn" %></li>
          <% end %>
        </ul>

        <h1 class="header-title"><%= link_to "Sweets Keep", root_path %></h1>

        <div class="header-menu-right">
          <!-- 共通：Top -->
          <%= link_to "Top", root_path, class: "header-menu-right-btn" %>

          <!-- 検索バー -->
          <%= render 'shared/search_form' %>
        </div>

      </nav>
    </header>

    <!-- メッセージ表示 -->
    <!-- flash.each にしておくと、notice や alert だけでなく、どんな種類のキー（flash.now[:alert] も含む）でも自動で取得して表示してくれる -->
    <% if flash.any? %>
      <div class="flash-container">
        <% flash.each do |message_type, message| %>
          <div class="flash-message flash-<%= message_type %>">
            <%= message %>
          </div>
        <% end %>
      </div>
    <% end %>

    <main class="main-content">
      <%= yield %>
    </main>
  </body>
</html>